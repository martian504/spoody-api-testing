    {
      "name": "Update Workout",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Workout updated successfully\", function () {\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(data.durationMinutes).to.eql(30);\r\n    pm.expect(data.sets).to.eql(5);\r\n    pm.expect(data.repetitions).to.eql(20);\r\n});\r\n\r\npm.test(\"Workout ID remains unchanged\", function () {\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(String(data.id)).to.eql(\r\n        pm.collectionVariables.get(\"workoutId\")\r\n    );\r\n});\r\n"
            ]
          }
        }
      ],
