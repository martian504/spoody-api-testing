    {
      "name": "NEG-02 - Missing Required Fields",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\npm.test(\"Mock API accepts incomplete workout\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Created workout is missing optional validation fields\", function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response).to.not.have.property(\"durationMinutes\");\r\n    pm.expect(response).to.not.have.property(\"sets\");\r\n    pm.expect(response).to.not.have.property(\"repetitions\");\r\n});\r\n\r\nconst createdWorkout = pm.response.json();\r\n\r\nif (pm.response.code === 201 && createdWorkout.id) {\r\n    pm.collectionVariables.set(\r\n        \"incompleteWorkoutId\",\r\n        createdWorkout.id\r\n    );\r\n}\r\n"
            ]
          }
        }
      ],
